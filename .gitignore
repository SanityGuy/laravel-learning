# ==============================================================================
# 1. YOUR BASE TEMPLATE (PRESERVED & EXPANDED)
# ==============================================================================
*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# ==============================================================================
# 2. MISSING CRITICAL LARAVEL STORAGE DIRECTORIES
# (Forces git to track the folders but completely ignores user-generated content)
# ==============================================================================
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# SQLite databases (Crucial if you run tests or local dev on SQLite)
/database/*.sqlite
/database/*.sqlite-journal

# ==============================================================================
# 3. MISSING LARAVEL ECOSYSTEM & COMPONENT CACHES
# ==============================================================================
.laravel-plan          # Laravel Sail plans
.pulse-lock            # Laravel Pulse temporary lockfiles
.laravel-pint.cache    # Laravel Pint style fixer cache
.phpunit.cache/        # Modern PHPUnit test caches

# ==============================================================================
# 4. MISSING IDE HELPER & COMPLIANCE EXTRA FILETYPES
# ==============================================================================
.phpstorm.meta.php     # Extra file generated by barryvdh/laravel-ide-helper
_ide_helper_models.php  # Extra file generated by barryvdh/laravel-ide-helper
npm-debug.log*         # Node failure logs
yarn-error.log*        # Yarn failure logs

# ==============================================================================
# 5. MISSING OPERATING SYSTEM ARTIFACTS
# ==============================================================================
.AppleDouble
.LSOverride
Ehthumbs.db
desktop.ini
$RECYCLE.BIN/
